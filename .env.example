# BhumiSetu Environment Configuration Template

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Local SQLite (default for development):
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/bhumisetu?schema=public"

# Security & Authentication
JWT_SECRET="replace-with-a-secure-random-256-bit-secret"
JWT_EXPIRES_IN="24h"

# Application URLs
FRONTEND_URL="http://localhost:3000"
API_PREFIX="/api/v1"

# Document Storage (local or s3)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# AWS S3 Configuration (if STORAGE_DRIVER="s3")
# S3_BUCKET="bhumisetu-documents"
# S3_REGION="ap-south-1"
# S3_ACCESS_KEY_ID="YOUR_S3_ACCESS_KEY"
# S3_SECRET_ACCESS_KEY="YOUR_S3_SECRET_KEY"

# Optional GIS / Map Provider API Key
MAP_API_KEY=""

# AI Studio / Gemini Key (if enabled)
GEMINI_API_KEY=""
